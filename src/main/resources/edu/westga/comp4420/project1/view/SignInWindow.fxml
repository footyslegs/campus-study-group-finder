<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>

<GridPane hgap="10.0" vgap="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.comp4420.project1.view.codebehind.SignInWindow">
	<padding>
		<Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
	</padding>
	<columnConstraints>
		<ColumnConstraints minWidth="90.0" />
		<ColumnConstraints minWidth="220.0" />
	</columnConstraints>
	<children>
		<Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Campus Study Group Finder" GridPane.columnSpan="2" GridPane.rowIndex="0" />
		<Label text="Name" GridPane.columnIndex="0" GridPane.rowIndex="1" />
		<TextField fx:id="nameTextField" promptText="Ada Lovelace" GridPane.columnIndex="1" GridPane.rowIndex="1" />
		<Label text="Student ID" GridPane.columnIndex="0" GridPane.rowIndex="2" />
		<TextField fx:id="studentIdTextField" promptText="900123456" GridPane.columnIndex="1" GridPane.rowIndex="2" />
		<Button fx:id="signInButton" defaultButton="true" maxWidth="Infinity" text="Sign In" GridPane.columnIndex="1" GridPane.rowIndex="3" />
		<Label fx:id="messageLabel" textFill="#b00020" GridPane.columnSpan="2" GridPane.rowIndex="4" />
	</children>
</GridPane>
