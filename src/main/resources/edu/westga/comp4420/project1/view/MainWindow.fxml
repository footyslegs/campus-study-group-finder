<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="460.0" prefWidth="720.0" spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.comp4420.project1.view.codebehind.MainWindow">
	<padding>
		<Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
	</padding>
	<children>
		<Label fx:id="welcomeLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
		<HBox fx:id="toolbar" spacing="10.0">
			<children>
				<Label text="Course" />
				<TextField fx:id="searchTextField" promptText="Search by course code, such as COMP 4420" HBox.hgrow="ALWAYS" />
				<Button fx:id="createGroupButton" text="Create Group" />
			</children>
		</HBox>
		<ListView fx:id="groupListView" VBox.vgrow="ALWAYS" />
	</children>
</VBox>
