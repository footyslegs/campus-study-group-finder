<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="420.0" prefWidth="460.0" spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.comp4420.project1.view.codebehind.GroupDetailsWindow">
	<padding>
		<Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
	</padding>
	<children>
		<Label fx:id="headingLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
		<Label fx:id="detailsLabel" />
		<Label fx:id="seatsLabel" />
		<Label text="Members" />
		<ListView fx:id="memberListView" VBox.vgrow="ALWAYS" />
		<HBox spacing="10.0">
			<children>
				<Button fx:id="joinButton" text="Join Group" />
				<Button fx:id="leaveButton" text="Leave Group" />
			</children>
		</HBox>
		<Label fx:id="messageLabel" textFill="#b00020" />
	</children>
</VBox>
